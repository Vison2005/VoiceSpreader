<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VoiceSpreader.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VoiceSpreader.App.Models"
    Background="{ThemeResource VoicePageBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
        <Grid
            x:Name="PageRoot"
            MaxWidth="1320"
            Padding="28,20,28,30"
            HorizontalAlignment="Stretch"
            SizeChanged="PageRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display, Segoe UI"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Text="同步控制台" />
                    <TextBlock
                        Foreground="{ThemeResource VoiceMutedTextBrush}"
                        Text="系统声音与多个 Windows 音频端点" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="22"
                        Height="22"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <Button
                        AutomationProperties.Name="刷新音频设备"
                        Click="RefreshButton_Click"
                        IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                        Style="{StaticResource VoiceIconButtonStyle}">
                        <SymbolIcon Symbol="Refresh" />
                        <ToolTipService.ToolTip>
                            <ToolTip Content="刷新音频设备" />
                        </ToolTipService.ToolTip>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                Grid.Row="1"
                Margin="0,0,0,14"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}"
                Severity="Warning"
                Title="需要注意" />

            <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                    <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="16">
                    <Border Padding="20,18" Style="{StaticResource VoiceCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource VoiceSectionTitleStyle}" Text="音频来源" />
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Header="系统声音"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.CaptureSources, Mode=OneWay}"
                                    DisplayMemberPath="DisplayName"
                                    SelectedItem="{x:Bind ViewModel.SelectedCapture, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Column="1"
                                    Header="校准麦克风"
                                    HorizontalAlignment="Stretch"
                                    IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.Microphones, Mode=OneWay}"
                                    DisplayMemberPath="DisplayName"
                                    SelectedItem="{x:Bind ViewModel.SelectedMicrophone, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="20,18" Style="{StaticResource VoiceCardStyle}">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource VoiceSectionTitleStyle}" Text="输出设备" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource VoiceSubtleTextBrush}"
                                        Text="勾选端点后可独立调整音量和正向补偿" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource VoiceMutedTextBrush}"
                                    Text="音量     补偿" />
                            </Grid>

                            <ListView
                                MaxHeight="410"
                                IsItemClickEnabled="False"
                                ItemsSource="{x:Bind ViewModel.Outputs, Mode=OneWay}"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:OutputEndpointItem">
                                        <Grid MinHeight="62" Padding="8,5" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="88" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="选择输出设备"
                                                Click="OutputCheckBox_Click"
                                                IsChecked="{x:Bind IsSelected, Mode=OneWay}" />
                                            <StackPanel Grid.Column="1" MinWidth="150" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource VoiceSubtleTextBrush}"
                                                    Text="{x:Bind CorrectionText, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Slider
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="输出音量"
                                                Maximum="100"
                                                Minimum="0"
                                                StepFrequency="1"
                                                Value="{x:Bind VolumePercent, Mode=OneWay}"
                                                ValueChanged="OutputVolumeSlider_ValueChanged" />
                                            <NumberBox
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="输出补偿毫秒"
                                                Maximum="500"
                                                Minimum="0"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{x:Bind DelayMilliseconds, Mode=OneWay}"
                                                ValueChanged="OutputDelayNumberBox_ValueChanged" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StatusColumn" Grid.Row="1" Spacing="16">
                    <Border Padding="20,18" Style="{StaticResource VoiceCardStyle}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource VoiceSectionTitleStyle}" Text="同步状态" />
                                <Border
                                    Grid.Column="1"
                                    Padding="9,3"
                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                    CornerRadius="8">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.StatusBadge, Mode=OneWay}" />
                                </Border>
                            </Grid>

                            <Grid Height="88">
                                <Rectangle
                                    Height="2"
                                    Margin="18,0"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource VoiceTrackBrush}"
                                    RadiusX="1"
                                    RadiusY="1" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedOutputs, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:OutputEndpointItem">
                                            <StackPanel Width="86" HorizontalAlignment="Center" Spacing="5">
                                                <Border
                                                    Width="30"
                                                    Height="30"
                                                    HorizontalAlignment="Center"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="15">
                                                    <FontIcon
                                                        FontSize="14"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Glyph="&#xE767;" />
                                                </Border>
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="{x:Bind Name}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource VoiceSubtleTextBrush}"
                                                    Text="{x:Bind DelayDisplay, Mode=OneWay}"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontFamily="Segoe UI Variable Display, Segoe UI"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="{ThemeResource VoiceMutedTextBrush}"
                                    Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Foreground="{ThemeResource VoiceSubtleTextBrush}"
                                Text="{x:Bind ViewModel.ProgramLevelText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="20,18" Style="{StaticResource VoiceCardStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock Style="{StaticResource VoiceSectionTitleStyle}" Text="同步设置" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="92" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="全局延迟" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource VoiceSubtleTextBrush}"
                                        Text="播放中可实时调整" />
                                </StackPanel>
                                <NumberBox
                                    Grid.Column="1"
                                    Maximum="100"
                                    Minimum="2"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    Value="{x:Bind ViewModel.BufferMilliseconds, Mode=OneWay}"
                                    ValueChanged="BufferNumberBox_ValueChanged" />
                            </Grid>
                            <ToggleSwitch
                                Header="端点自动补偿"
                                IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.AutomaticLatencyCompensation, Mode=TwoWay}" />
                            <ToggleSwitch
                                Header="自同步声学跟踪"
                                IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.ContinuousAcousticTracking, Mode=TwoWay}" />
                            <ToggleSwitch
                                Header="独占输出"
                                IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.ExclusiveMode, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            Padding="28,12"
            Background="{ThemeResource VoiceSurfaceBrush}"
            BorderBrush="{ThemeResource VoiceStrokeBrush}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="1320" HorizontalAlignment="Stretch" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Expander Header="运行记录" HorizontalAlignment="Stretch">
                    <ListView
                        MaxHeight="180"
                        Margin="0,10,0,0"
                        ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}"
                        SelectionMode="None" />
                </Expander>
                <Button
                    Grid.Column="1"
                    MinWidth="110"
                    MinHeight="42"
                    VerticalAlignment="Center"
                    Click="CalibrateButton_Click"
                    Content="{x:Bind ViewModel.CalibrationButtonText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsEngineAvailable, Mode=OneWay}" />
                <Button
                    Grid.Column="2"
                    MinWidth="132"
                    MinHeight="42"
                    VerticalAlignment="Center"
                    Click="StartButton_Click"
                    Content="{x:Bind ViewModel.StartButtonText, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsEngineAvailable, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
