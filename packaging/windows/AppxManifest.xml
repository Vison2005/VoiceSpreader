<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="desktop uap uap10 rescap">
  <Identity
    Name="Vison2005.SoundSpreader"
    Publisher="CN=Vison2005"
    Version="1.3.0.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>SoundSpreader</DisplayName>
    <PublisherDisplayName>Vison2005</PublisherDisplayName>
    <Description>SoundSpreader Windows 多设备音频同步与蓝牙 A2DP 音频接收工具</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="zh-CN" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application
      Id="SoundSpreader"
      Executable="SoundSpreader.exe"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        AppListEntry="default"
        BackgroundColor="transparent"
        Description="SoundSpreader Windows 多设备音频同步与蓝牙 A2DP 音频接收工具"
        DisplayName="SoundSpreader"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="SoundSpreader.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="SoundSpreaderStartup"
            Enabled="false"
            DisplayName="SoundSpreader" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
